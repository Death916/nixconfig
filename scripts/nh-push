#!/usr/bin/env bash

# A wrapper for 'nh' that runs 'git pull' and 'git push' on success.
#   nh-push        -> nh os switch (this host)
#   nh-push <host> -> nh os switch -H <host>
#   nh-push home   -> nh home switch

# Exit immediately if a command exits with a non-zero status.
set -e

# Determine the absolute path of the directory containing this script.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
# The repository root is one level above the scripts directory.
REPO_ROOT=$(realpath "$SCRIPT_DIR/..")

MODE="os"
if [ "${1:-}" = "home" ]; then
    MODE="home"
    shift
fi

# --- Git Operations ---
echo "Pulling latest changes from git..."
# Use -C to specify the repository path for git operations.
git -C "$REPO_ROOT" pull

# --- Snapshot Creation ---
if [ -d "/snapshots" ]; then
    SNAPSHOT_DIR="/snapshots"
elif [ -d "/.snapshots" ]; then
    SNAPSHOT_DIR="/.snapshots"
fi

RETAIN=20

snapshot() {
    local kind="$1"
    echo "Creating btrfs snapshot of /$kind in $SNAPSHOT_DIR..."
    sudo btrfs subvolume snapshot -r "/$kind" "$SNAPSHOT_DIR/${kind}_$(date +%Y-%m-%d_%H%M)"
}

prune() {
    local kind="$1"
    local old=()
    local deleted=0

    mapfile -t old < <(sudo find "$SNAPSHOT_DIR" -maxdepth 1 -name "${kind}_*" -printf "%T@ %p\n" | sort -n | cut -d' ' -f2- | head -n -"$RETAIN")
    for snap in "${old[@]}"; do
        if [ -n "$snap" ]; then
            echo "Deleting old $kind snapshot: $(basename "$snap")"
            sudo btrfs subvolume delete "$snap"
            deleted=$((deleted + 1))
        fi
    done
    if [ "$deleted" -gt 0 ]; then
        echo "Deleted $deleted old $kind snapshot(s)."
    else
        echo "No $kind snapshots needed pruning."
    fi
}

if [ -n "${SNAPSHOT_DIR:-}" ]; then
    if [ "$MODE" = "os" ]; then
        snapshot nix
    fi
    snapshot home
    echo "Snapshots created."

    echo "Pruning older snapshots (retaining last $RETAIN of each)..."
    if [ "$MODE" = "os" ]; then
        prune nix
    fi
    prune home
fi

# --- Build ---
if [ "$MODE" = "home" ]; then
    echo "Building Home Manager configuration..."
    echo "Running: nh home switch \"$REPO_ROOT\" -b backup --diff always"
    nh home switch "$REPO_ROOT" -b backup --diff always
else
    echo "Building NixOS configuration..."
    # If an argument is provided, use it as the hostname with -H.
    # Otherwise, resolve the current hostname and use it.
    if [ -z "${1:-}" ]; then
        CURRENT_HOSTNAME=$(hostname)
        echo "Running: nh os switch \"$REPO_ROOT\" -H \"$CURRENT_HOSTNAME\" --diff always"
        nh os switch "$REPO_ROOT" -H "$CURRENT_HOSTNAME" --diff always
    else
        echo "Running: nh os switch \"$REPO_ROOT\" -H \"$*\" --diff always"
        nh os switch "$REPO_ROOT" -H "$*" --diff always
    fi
fi

# --- Git Push on Success ---
echo "Rebuild successful. Pushing to remote..."
git -C "$REPO_ROOT" push

echo "Push complete."
