+def _missing_task_ids_any_board(ids: Iterable[str]) -> list[str]:
+    """Subset of ``ids`` (order kept) that exists on NO board under
+    :func:`kanban_home()` — the plain :func:`_missing_task_ids` widened across
+    boards.
+
+    A completion summary legitimately names cards that live on another board
+    (this host runs several), and those are unresolvable against the completing
+    board alone. Resolving per board first turns them from
+    ``suspected_hallucinated_references`` hits — whose advisory diagnostic can
+    trigger a reclaim of a still-running worker — into what they are: real
+    references. Advisory path only: a board that cannot be read leaves its ids
+    counted as missing, so the false-negative side stays cheap.
+    """
+    ids = list(ids)
+    if not ids:
+        return []
+    missing = set(ids)
+    for path in _board_db_paths():
+        if not missing:
+            break
+        if not path.exists():
+            continue
+        try:
+            conn = sqlite3.connect(path.resolve().as_uri() + "?mode=ro", uri=True)
+        except sqlite3.Error:
+            continue
+        try:
+            placeholders = ",".join("?" * len(missing))
+            rows = conn.execute(
+                f"SELECT id FROM tasks WHERE id IN ({placeholders})", sorted(missing)
+            ).fetchall()
+            missing -= {r[0] for r in rows}
+        except sqlite3.Error:
+            continue
+        finally:
+            conn.close()
+    return [p for p in ids if p in missing]
+
