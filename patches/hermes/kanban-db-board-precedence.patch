+def _board_db_paths() -> list[Path]:
+    """Every board DB under :func:`kanban_home()`: the ``default`` board plus one
+    ``<root>/kanban/boards/<slug>/kanban.db`` per named board (created boards with
+    no DB yet are included; callers skip non-existent paths)."""
+    paths = [kanban_home() / "kanban.db"]
+    try:
+        entries = sorted(boards_root().iterdir())
+    except OSError:
+        return paths
+    for entry in entries:
+        if entry.is_dir():
+            paths.append(entry / "kanban.db")
+    return paths
+
