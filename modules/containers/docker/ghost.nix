# Ghost stack -- declarative port of ~/prod/ghost/ghost-docker/compose.yml
#
# Same lesson as the piefed stack: the ghost container bind-mounts
# /mnt/myjfs/ghost/content, and /mnt/myjfs is itself served by a container
# (JuiceFS). Restarting the docker units can start ghost before that mount is
# answering -- the "mkdir /mnt/myjfs: file exists" race that took piefed down
# for two days on 2026-10-21. So the content-using unit is ordered after
# docker-myjfs-mount-service AND blocks until the mount really exists.
#
# /etc/nixos/secrets/ghost.env is NOT a copy of compose's .env: compose remapped
# the names (DATABASE_ROOT_PASSWORD -> MYSQL_ROOT_PASSWORD, DATABASE_PASSWORD ->
# MYSQL_PASSWORD and database__connection__password). The env file therefore
# holds the *container-facing* names:
#   MYSQL_ROOT_PASSWORD, MYSQL_PASSWORD, database__connection__password,
#   mail__options__auth__pass, NEWT_SECRET
#
# Migration (one time):
#   cd ~/prod/ghost/ghost-docker && docker compose down
# then nixos-rebuild switch. MySQL data stays on the same bind mount
# (~/prod/ghost/ghost-docker/data/mysql) and content on /mnt/myjfs/ghost, so
# nothing moves.
#
# Auto-generated by compose2nix, hand-cleaned.
{ pkgs, lib, ... }:

let
  # Read in place (a plain string, not a nix path) so the env file is never
  # copied into the world-readable /nix/store.
  envFile = "/etc/nixos/secrets/ghost.env";

  # Type=simple means "container started", not "FUSE mount is answering".
  waitForMount = pkgs.writeShellScript "ghost-wait-myjfs" ''
    i=0
    while [ "$i" -lt 90 ]; do
      if ${pkgs.util-linux}/bin/mountpoint -q /mnt/myjfs; then
        exit 0
      fi
      i=$((i + 1))
      sleep 2
    done
    echo "ghost: /mnt/myjfs still not mounted after 180s, refusing to start" >&2
    exit 1
  '';

  # Flake evaluation cannot stat /etc/..., so check at start time instead.
  checkEnv = pkgs.writeShellScript "ghost-check-env" ''
    if [ ! -r ${envFile} ]; then
      echo "ghost: ${envFile} is missing or unreadable" >&2
      exit 1
    fi
    for k in MYSQL_ROOT_PASSWORD MYSQL_PASSWORD database__connection__password; do
      if ! grep -q "^$k=." ${envFile}; then
        echo "ghost: $k missing or empty in ${envFile}" >&2
        exit 1
      fi
    done
  '';

  commonUnit = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
      RestartMaxDelaySec = lib.mkOverride 90 "1m";
      RestartSec = lib.mkOverride 90 "100ms";
      RestartSteps = lib.mkOverride 90 9;
      ExecStartPre = [ checkEnv ];
    };
    after = [
      "docker-network-ghost_ghost_network.service"
    ];
    requires = [
      "docker-network-ghost_ghost_network.service"
    ];
    partOf = [
      "docker-compose-ghost-root.target"
    ];
    wantedBy = [
      "docker-compose-ghost-root.target"
    ];
  };

  # Same as commonUnit plus the JuiceFS ordering for anything touching /mnt/myjfs.
  contentUnit = commonUnit // {
    serviceConfig = commonUnit.serviceConfig // {
      ExecStartPre = [ checkEnv waitForMount ];
    };
    unitConfig.RequiresMountsFor = "/mnt/myjfs";
    after = commonUnit.after ++ [ "docker-myjfs-mount-service.service" ];
    requires = commonUnit.requires ++ [ "docker-myjfs-mount-service.service" ];
  };
in
{
  virtualisation.oci-containers.backend = "docker";

  # Containers
  virtualisation.oci-containers.containers."ghost-db" = {
    image = "mysql:8.0.44@sha256:f37951fc3753a6a22d6c7bf6978c5e5fefcf6f31814d98c582524f98eae52b21";
    environment = {
      MYSQL_DATABASE = "ghost";
      MYSQL_MULTIPLE_DATABASES = "activitypub";
      MYSQL_USER = "ghost";
    };
    environmentFiles = [
      envFile
    ];
    volumes = [
      "/home/death916/prod/ghost/ghost-docker/data/mysql:/var/lib/mysql:rw"
      "/home/death916/prod/ghost/ghost-docker/mysql-init:/docker-entrypoint-initdb.d:rw"
    ];
    log-driver = "journald";
    extraOptions = [
      "--health-cmd=mysqladmin ping -p$MYSQL_ROOT_PASSWORD -h 127.0.0.1"
      "--health-interval=1s"
      "--health-retries=120"
      "--health-start-interval=10s"
      "--health-start-period=30s"
      "--network-alias=db"
      "--network=ghost_ghost_network"
    ];
  };
  systemd.services."docker-ghost-db" = commonUnit;

  virtualisation.oci-containers.containers."ghost-ghost" = {
    image = "ghost:6-alpine";
    environment = {
      NODE_ENV = "production";
      url = "https://blog.death916.xyz";
      database__client = "mysql";
      database__connection__host = "db";
      database__connection__user = "ghost";
      database__connection__database = "ghost";
      mail__transport = "SMTP";
      mail__options__host = "mail.smtp2go.com";
      mail__options__port = "465";
      mail__options__secure = "true";
      mail__options__auth__user = "mail@death916.xyz";
      mail__from = "'Death916 Blog Support' <mail@death916.xyz>";
      NODE_TLS_REJECT_UNAUTHORIZED = "0";
      security__staffDeviceVerification = "false";
      # Kept from the compose file so Ghost's analytics keep pointing at the
      # self-hosted endpoint rather than a cloud default.
      tinybird__tracker__endpoint = "https://blog.death916.xyz/.ghost/analytics/api/v1/page_hit";
      tinybird__tracker__datasource = "analytics_events";
      tinybird__stats__endpoint = "https://api.tinybird.co";
    };
    environmentFiles = [
      envFile
    ];
    volumes = [
      "/mnt/myjfs/ghost/content:/var/lib/ghost/content:rw"
    ];
    labels = {
      "pangolin.public-resources.ghost.auth.sso-enabled" = "false";
      "pangolin.public-resources.ghost.full-domain" = "blog.death916.xyz";
      "pangolin.public-resources.ghost.mode" = "http";
      "pangolin.public-resources.ghost.name" = "Ghost Blog";
      "pangolin.public-resources.ghost.targets[0].hostname" = "ghost";
      "pangolin.public-resources.ghost.targets[0].method" = "http";
      "pangolin.public-resources.ghost.targets[0].port" = "2368";
    };
    dependsOn = [
      "ghost-db"
    ];
    log-driver = "journald";
    extraOptions = [
      "--network-alias=ghost"
      "--network=ghost_ghost_network"
    ];
  };
  systemd.services."docker-ghost-ghost" = contentUnit;

  virtualisation.oci-containers.containers."ghost-newt" = {
    image = "fosrl/newt:latest";
    environment = {
      PANGOLIN_ENDPOINT = "https://admin.death916.xyz";
      NEWT_ID = "61v7q2k9bg6p9gs";
      DOCKER_SOCKET = "/var/run/docker.sock";
      SKIP_TLS_VERIFY = "true";
    };
    environmentFiles = [
      envFile
    ];
    volumes = [
      "/var/run/docker.sock:/var/run/docker.sock:ro"
    ];
    dependsOn = [
      "ghost-ghost"
    ];
    log-driver = "journald";
    extraOptions = [
      "--add-host=admin.death916.xyz:host-gateway"
      "--add-host=death916.xyz:host-gateway"
      "--network-alias=newt"
      "--network=ghost_ghost_network"
    ];
  };
  systemd.services."docker-ghost-newt" = commonUnit;

  # Networks
  systemd.services."docker-network-ghost_ghost_network" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStop = "docker network rm -f ghost_ghost_network";
    };
    script = ''
      docker network inspect ghost_ghost_network || docker network create ghost_ghost_network
    '';
    partOf = [ "docker-compose-ghost-root.target" ];
    wantedBy = [ "docker-compose-ghost-root.target" ];
  };

  # Root service
  systemd.targets."docker-compose-ghost-root" = {
    unitConfig = {
      Description = "Root target for Ghost CMS.";
    };
    wantedBy = [ "multi-user.target" ];
  };
}
